# === Dependencies ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json   # optional: remove this line if you want to commit lock file

# === Environment & Secrets ===
.env
.env.*              # catches .env.local, .env.production, .env.staging etc.
*.pem               # private key files
*.key               # API keys / TLS keys
*.cert              # certificates
*.p12
secrets.json
credentials.json
service-account*.json   # Firebase / GCP service account keys

# === Logs ===
*.log
logs/
npm-debug.log

# === OS Files ===
.DS_Store           # macOS
Thumbs.db           # Windows
desktop.ini         # Windows

# === Editor / IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Build / Dist ===
dist/
build/
out/
.cache/

# === Ngrok ===
ngrok.yml
ngrok.log
*.ngrok.io

# === Misc ===
*.tmp
*.bak
coverage/
.nyc_output/
